{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "database",
    "rate_limits"
  ],
  "properties": {
    "database": {
      "additionalProperties": false,
      "properties": {
        "endpoint": {
          "additionalProperties": false,
          "properties": {
            "host": {
              "type": "string"
            },
            "labels": {
              "anyOf": [
                {
                  "additionalProperties": {
                    "anyOf": [
                      {
                        "items": {
                          "type": "string"
                        },
                        "type": "array"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "type": "object"
                },
                {
                  "type": "null"
                }
              ]
            },
            "ports": {
              "anyOf": [
                {
                  "items": {
                    "maximum": 65535,
                    "minimum": 0,
                    "type": "integer"
                  },
                  "type": "array"
                },
                {
                  "type": "null"
                }
              ]
            },
            "zones": {
              "items": {
                "type": "string"
              },
              "maxItems": 2,
              "minItems": 2,
              "type": "array"
            }
          },
          "required": [
            "host",
            "ports",
            "labels",
            "zones"
          ],
          "type": "object"
        },
        "timeout": {
          "format": "go-duration",
          "type": "string"
        }
      },
      "required": [
        "endpoint",
        "timeout"
      ],
      "type": "object"
    },
    "rate_limits": {
      "additionalProperties": false,
      "properties": {
        "limit": {
          "maximum": 32767,
          "minimum": -32768,
          "type": "integer"
        },
        "payload": {
          "anyOf": [
            {
              "format": "kms-base64",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "ratio": {
          "anyOf": [
            {
              "maximum": 3.4028234663852886e+38,
              "minimum": -3.4028234663852886e+38,
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "limit",
        "payload",
        "ratio"
      ],
      "type": "object"
    }
  }
}
