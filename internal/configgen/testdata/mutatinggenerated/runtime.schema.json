{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Config is a generation fixture whose validation canonicalizes a field in place. The generated store must compare the two validated copies, not the original unvalidated defaults retained by the Store.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "runtime"
  ],
  "properties": {
    "runtime": {
      "additionalProperties": false,
      "default": {
        "name": "  canonical name  "
      },
      "properties": {
        "name": {
          "default": "  canonical name  ",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    }
  }
}
