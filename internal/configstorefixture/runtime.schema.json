{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "database",
    "runtime"
  ],
  "properties": {
    "database": {
      "additionalProperties": false,
      "properties": {
        "endpoint": {
          "additionalProperties": false,
          "properties": {
            "host": {
              "type": "string"
            },
            "labels": {
              "additionalProperties": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "type": "object"
            },
            "ports": {
              "items": {
                "maximum": 65535,
                "minimum": 0,
                "type": "integer"
              },
              "type": "array"
            },
            "zones": {
              "items": {
                "type": "string"
              },
              "maxItems": 2,
              "minItems": 2,
              "type": "array"
            }
          },
          "required": [
            "host",
            "ports",
            "labels",
            "zones"
          ],
          "type": "object"
        },
        "max_open": {
          "anyOf": [
            {
              "maximum": 9223372036854775807,
              "minimum": -9223372036854775808,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "timeout": {
          "format": "go-duration",
          "type": "string"
        }
      },
      "required": [
        "endpoint",
        "max_open",
        "timeout"
      ],
      "type": "object"
    },
    "runtime": {
      "additionalProperties": false,
      "properties": {
        "features": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "payload": {
          "format": "kms-base64",
          "type": "string"
        },
        "thresholds": {
          "additionalProperties": {
            "maximum": 18446744073709551615,
            "minimum": 0,
            "type": "integer"
          },
          "type": "object"
        },
        "window": {
          "items": {
            "maximum": 1.7976931348623157e+308,
            "minimum": -1.7976931348623157e+308,
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        }
      },
      "required": [
        "features",
        "payload",
        "thresholds",
        "window"
      ],
      "type": "object"
    }
  }
}
